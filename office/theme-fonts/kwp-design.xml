<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  kwp design - Microsoft Office theme fonts.

  The companion to office/theme-colors/kwp-design.xml. Install both and Design
  > Fonts lists "kwp-design" beside the color set. Full setup, including which
  font files to install and why the names below are what they are:

      docs/office-theme.md

  "Lora SemiBold" is NOT a typo for "Lora". The system ships Lora at weight 600
  and no other weight (see tokens/fonts.css). On Windows the static SemiBold
  face installs under its own family name, exactly as Office's own themes name
  "Calibri Light" rather than asking for Calibri and hoping. Naming the family
  that carries the weight is what stops Word synthesising one.

  So: do not bold a heading in this theme. The weight is already in the face.

  Hanken Grotesk is variable on the web and static on the desktop; install the
  four regular/italic/bold/bold-italic files so Word's B and I map to real
  faces instead of faking them.
-->
<a:fontScheme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="kwp-design">
  <a:majorFont>
    <a:latin typeface="Lora SemiBold"/>
    <a:ea typeface=""/>
    <a:cs typeface=""/>
  </a:majorFont>
  <a:minorFont>
    <a:latin typeface="Hanken Grotesk"/>
    <a:ea typeface=""/>
    <a:cs typeface=""/>
  </a:minorFont>
</a:fontScheme>
