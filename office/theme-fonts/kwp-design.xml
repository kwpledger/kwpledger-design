<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  kwp design - Microsoft Office theme fonts.

  The companion to office/theme-colors/kwp-design.xml. Install both and Design
  > Fonts lists "kwp-design" beside the color set. Full setup, including which
  font files to install and why the names below are what they are:

      docs/office-theme.md

  Headings are plain "Lora" (Kevin, 2026-10-16). Until v0.11.0 this named
  "Lora SemiBold", because the web files shipped Lora at weight 600 only;
  they are variable now (see tokens/fonts.css), so there is no single weight
  to pin the desktop to.

  Both families: install the static regular/italic/bold/bold-italic files so
  Word's B and I map to real faces instead of faking them.
-->
<a:fontScheme xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" name="kwp-design">
  <a:majorFont>
    <a:latin typeface="Lora"/>
    <a:ea typeface=""/>
    <a:cs typeface=""/>
  </a:majorFont>
  <a:minorFont>
    <a:latin typeface="Hanken Grotesk"/>
    <a:ea typeface=""/>
    <a:cs typeface=""/>
  </a:minorFont>
</a:fontScheme>
